# Copy to .env.local and fill in as needed. All values are optional —
# the app runs fully without credentials using public, keyless APIs.

# Override external endpoints
#VITE_BASEMAP_TILES=
#VITE_LANDSAT_STAC=
#VITE_EARTH_SEARCH_STAC=
#VITE_USGS_M2M=
#VITE_NOMINATIM=
#VITE_TITILER=
#VITE_CORS_IMAGE_PROXY=

# USGS M2M credentials are workflow-only (GitHub Actions secrets
# USGS_M2M_USERNAME / USGS_M2M_TOKEN). Never add them here: every VITE_
# variable is bundled into the public JavaScript served to visitors.

# Google Earth Engine OAuth client id
#VITE_EE_CLIENT_ID=
